---
import AppCard from '../components/AppCard.astro';
import { apps } from '../apps';
import { site, externalAttrs } from '../config';
import '../styles/global.css';

const readyCount = apps.filter((a) => a.status === 'ready').length;

// Copyright holder: the university when configured, otherwise the site name.
const year = new Date().getFullYear();
const owner = site.university || site.name;
const ownerUrl = site.university ? site.links.university : undefined;

// Links whose PUBLIC_* var is unset are dropped rather than rendered dead.
const navLinks = [
	{ label: 'Docs', href: site.links.docs },
	{ label: 'Website', href: site.links.landing },
	{ label: 'GitHub', href: site.links.github },
].filter((l) => l.href);

const legalLinks = [
	{ label: 'Imprint', href: site.legal.imprint },
	{ label: 'Privacy', href: site.legal.privacy },
	{ label: 'Disclaimer', href: site.legal.disclaimer },
].filter((l) => l.href);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<script is:inline>
			// Pre-paint: apply a saved choice only. With none, the CSS media
			// query follows the operating system, so this also works without JS.
			(() => {
				try {
					const saved = localStorage.getItem('mb-theme');
					if (saved === 'dark' || saved === 'light') {
						document.documentElement.dataset.theme = saved;
					}
				} catch {
					/* private mode etc. — the OS preference still applies */
				}
			})();
		</script>
		<title>{site.name}</title>
		<meta
			name="description"
			content="Example apps embedding Morphic Blocks in different frameworks and toolchains."
		/>
	</head>
	<body>
		<header class="container site-header">
			<span class="brand">
				<img src="/logo.svg" alt="" width="32" height="32" />
				{site.name}
			</span>
			<div class="right">
				<nav>
					{navLinks.map((l) => (
						<a href={l.href} {...externalAttrs(l.href)}>
							{l.label}
						</a>
					))}
				</nav>
				<button id="theme-toggle" type="button" aria-label="Toggle color theme">
					<svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
					<svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
				</button>
			</div>
		</header>

		<main class="container">
			<h1>Example apps</h1>
			<p class="lede">
				The same Morphic Blocks setup, embedded in different frameworks and
				built with different toolchains. Every app is self-contained — download
				a folder and run it on its own.
			</p>

			{
				readyCount === 0 && (
					<p class="notice">
						These apps are planned — the shell is in place and each one will
						land here as it is built.
					</p>
				)
			}

			<section class="grid">
				{apps.map((app) => <AppCard app={app} />)}
			</section>
		</main>

		<footer class="container site-footer">
			<span class="copyright">
				© {year}{' '}
				{ownerUrl ? (
					<a href={ownerUrl} {...externalAttrs(ownerUrl)}>
						{owner}
					</a>
				) : (
					owner
				)}
			</span>
			{
				legalLinks.length > 0 && (
					<nav class="legal" aria-label="Legal">
						{legalLinks.map((l) => (
							<a href={l.href} {...externalAttrs(l.href)}>
								{l.label}
							</a>
						))}
					</nav>
				)
			}
		</footer>

		<script is:inline>
			// Theme toggle: flips the current theme and remembers the choice.
			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const root = document.documentElement;
				const current =
					root.dataset.theme ||
					(matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				const next = current === 'dark' ? 'light' : 'dark';
				root.dataset.theme = next;
				try {
					localStorage.setItem('mb-theme', next);
				} catch {
					/* private mode etc. — non-fatal */
				}
			});

			// "Copy CLI" buttons — copy the degit command for that app.
			document.querySelectorAll('button[data-copy]').forEach((btn) => {
				btn.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(btn.dataset.copy);
						const original = btn.textContent;
						btn.textContent = 'Copied';
						setTimeout(() => (btn.textContent = original), 1500);
					} catch {
						/* clipboard unavailable — ignore */
					}
				});
			});
		</script>
	</body>
</html>

<style>
	.site-header {
		border-bottom: 1px solid var(--border);
		margin-bottom: 0.4rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.1rem;
		flex-wrap: wrap;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.site-header nav {
		display: flex;
		gap: 1rem;
		font-size: 0.92rem;
	}
	.site-header nav a {
		text-decoration: none;
		color: var(--text-muted);
	}
	.site-header nav a:hover {
		color: var(--accent);
	}
	.right {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	/* Borderless, so it carries the same weight as the text nav links. */
	#theme-toggle {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
	}
	#theme-toggle:hover {
		color: var(--accent);
		background: var(--preview-bg);
	}
	/* Show the icon for the theme the button switches to. */
	.icon-sun {
		display: none;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .icon-sun {
			display: block;
		}
		:global(:root:not([data-theme='light'])) .icon-moon {
			display: none;
		}
	}
	:global(:root[data-theme='dark']) .icon-sun {
		display: block;
	}
	:global(:root[data-theme='dark']) .icon-moon {
		display: none;
	}

	h1 {
		margin: 1.5rem 0 0.5rem;
		font-size: clamp(1.5rem, 3.2vw, 2rem);
	}
	.lede {
		color: var(--text-muted);
		max-width: 62ch;
		margin: 0 0 1.5rem;
	}
	.notice {
		border: 1px dashed var(--border);
		border-radius: var(--radius-sm);
		padding: 0.7rem 0.9rem;
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 1.5rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
		gap: 1.1rem;
		padding-bottom: 3rem;
	}

	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		border-top: 1px solid var(--border);
		padding-block: 1.3rem;
		color: var(--text-muted);
		font-size: 0.88rem;
	}
	.copyright a {
		color: inherit;
		text-decoration: none;
	}
	.copyright a:hover {
		color: var(--accent);
	}
	.site-footer .legal {
		display: flex;
		gap: 1rem;
	}
	.site-footer .legal a {
		color: var(--text-muted);
		text-decoration: none;
	}
	.site-footer .legal a:hover {
		color: var(--accent);
	}
</style>
