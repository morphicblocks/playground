---
import AppCard from '../components/AppCard.astro';
import AppTable from '../components/AppTable.astro';
import { apps } from '../apps';
import { site, externalAttrs } from '../config';
import { blockColor } from '../palette';
import '../styles/global.css';


// Absolute URLs, which link previews and canonical tags both require. They are
// only emitted when PUBLIC_SITE_URL is set, since a relative one is rejected.
const description =
	'Example apps showing different use cases of Morphic Blocks, each built with a different stack.';
const canonical = Astro.site
	? new URL(Astro.url.pathname, Astro.site).href
	: undefined;
const ogImage = Astro.site ? new URL('og.png', Astro.site).href : undefined;

// Copyright holder: the university when configured, otherwise the site name.
const year = new Date().getFullYear();
const owner = site.university || site.name;
const ownerUrl = site.university ? site.links.university : undefined;

// Links whose PUBLIC_* var is unset are dropped rather than rendered dead.
const navLinks = [
	{ label: 'Docs', href: site.links.docs },
	{ label: 'Website', href: site.links.landing },
	{ label: 'GitHub', href: site.links.github },
].filter((l) => l.href);

const legalLinks = [
	{ label: 'Imprint', href: site.legal.imprint },
	{ label: 'Privacy', href: site.legal.privacy },
	{ label: 'Disclaimer', href: site.legal.disclaimer },
].filter((l) => l.href);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- SVG for modern browsers, sized PNGs as fallback. Google wants a search
		     favicon larger than 48px, so the 192px icon is declared here as well.
		     /favicon.ico is served at the root for tools that request it directly. -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<script is:inline>
			// Pre-paint: apply a saved choice only. With none, the CSS media
			// query follows the operating system, so this also works without JS.
			(() => {
				try {
					const saved = localStorage.getItem('mb-theme');
					if (saved === 'dark' || saved === 'light') {
						document.documentElement.dataset.theme = saved;
					}
				} catch {
					/* private mode etc. — the OS preference still applies */
				}
			})();
		</script>
		<title>{site.name}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:title" content={site.name} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		{canonical && <meta property="og:url" content={canonical} />}
		{
			ogImage && (
				<>
					<meta property="og:image" content={ogImage} />
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
					<meta property="og:image:alt" content={site.name} />
				</>
			)
		}
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<!-- Opened on phones only (see the script below): the apps put blocks,
		     text and output side by side. -->
		<dialog id="screen-note" class="screen-note" aria-labelledby="screen-note-title">
			<h2 id="screen-note-title">Best on a big screen</h2>
			<p>
				These apps show blocks, code and output side by side. Open them in a
				desktop or tablet browser for the full experience.
			</p>
			<form method="dialog">
				<button type="submit">Continue anyway</button>
			</form>
		</dialog>
		<header class="container site-header">
			<span class="brand">
				<img src="/logo.svg" alt="" width="32" height="32" />
				{site.name}
			</span>
			<div class="right">
				<nav>
					{navLinks.map((l) => (
						<a href={l.href} {...externalAttrs(l.href)}>
							{l.label}
						</a>
					))}
				</nav>
				<button id="theme-toggle" type="button" aria-label="Toggle color theme">
					<svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
					<svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
				</button>
			</div>
		</header>

		<main class="container">
			<!-- A row of blocks in the card colors, as a small hello. -->
			<div class="block-row" aria-hidden="true">
				{[0, 1, 2, 3, 4, 5].map((i) => <span style={`--card: ${blockColor(i)}`} />)}
			</div>
			<h1>Example apps</h1>
			<p class="lede">
				Each app shows a different use case of Morphic Blocks, built with a
				different stack. Every app is self contained: open it, read its source,
				or copy it with one command and run it on its own.
			</p>

			{
				apps.length === 0 && (
					<p class="notice">
						The first apps are being built and will appear here soon.
					</p>
				)
			}

			<section class="grid">
				{apps.map((app, index) => <AppCard app={app} index={index} />)}
			</section>

			{apps.length > 0 && <AppTable apps={apps} />}
		</main>

		<footer class="container site-footer">
			<span class="copyright">
				© {year}{' '}
				{ownerUrl ? (
					<a href={ownerUrl} {...externalAttrs(ownerUrl)}>
						{owner}
					</a>
				) : (
					owner
				)}
			</span>
			{
				legalLinks.length > 0 && (
					<nav class="legal" aria-label="Legal">
						{legalLinks.map((l) => (
							<a href={l.href} {...externalAttrs(l.href)}>
								{l.label}
							</a>
						))}
					</nav>
				)
			}
		</footer>

		<script is:inline>
			// Theme toggle: flips the current theme and remembers the choice.
			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const root = document.documentElement;
				const current =
					root.dataset.theme ||
					(matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				const next = current === 'dark' ? 'light' : 'dark';
				root.dataset.theme = next;
				try {
					localStorage.setItem('mb-theme', next);
				} catch {
					/* private mode etc. — non-fatal */
				}
			});

			// The screen size note opens once on phones; closing it, with the
			// button or Escape, is remembered.
			(() => {
				const note = document.getElementById('screen-note');
				if (!note || !matchMedia('(pointer: coarse) and (max-width: 700px)').matches) return;
				try {
					if (localStorage.getItem('mb-screen-note') === 'closed') return;
				} catch {
					/* private mode etc. — show it for this visit */
				}
				note.addEventListener('close', () => {
					try {
						localStorage.setItem('mb-screen-note', 'closed');
					} catch {
						/* private mode etc. — closed for this visit only */
					}
				});
				note.showModal();
			})();

			// "Copy CLI" buttons: copy the command that downloads that app.
			document.querySelectorAll('button[data-copy]').forEach((btn) => {
				btn.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(btn.dataset.copy);
						const original = btn.textContent;
						btn.textContent = 'Copied';
						setTimeout(() => (btn.textContent = original), 1500);
					} catch {
						/* clipboard unavailable — ignore */
					}
				});
			});
		</script>
	</body>
</html>

<style>
	.screen-note {
		width: min(22rem, calc(100vw - 2.5rem));
		padding: 1.4rem 1.3rem 1.2rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--text);
	}
	.screen-note::backdrop {
		background: rgb(0 0 0 / 0.35);
		-webkit-backdrop-filter: blur(4px);
		backdrop-filter: blur(4px);
	}
	.screen-note h2 {
		margin: 0 0 0.5rem;
		font-size: 1.2rem;
	}
	.screen-note p {
		margin: 0 0 1.2rem;
		color: var(--text-muted);
	}
	.screen-note button {
		width: 100%;
		padding: 0.7rem 1rem;
		border: 0;
		border-radius: var(--radius-sm);
		background: var(--accent);
		color: #fff;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.site-header {
		border-bottom: 1px solid var(--border);
		margin-bottom: 0.4rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.1rem;
		flex-wrap: wrap;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.site-header nav {
		display: flex;
		gap: 1rem;
		font-size: 0.92rem;
	}
	.site-header nav a {
		text-decoration: none;
		color: var(--text-muted);
	}
	.site-header nav a:hover {
		color: var(--accent);
	}
	.right {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	/* Borderless, so it carries the same weight as the text nav links. */
	#theme-toggle {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
	}
	#theme-toggle:hover {
		color: var(--accent);
		background: var(--preview-bg);
	}
	/* Show the icon for the theme the button switches to. */
	.icon-sun {
		display: none;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .icon-sun {
			display: block;
		}
		:global(:root:not([data-theme='light'])) .icon-moon {
			display: none;
		}
	}
	:global(:root[data-theme='dark']) .icon-sun {
		display: block;
	}
	:global(:root[data-theme='dark']) .icon-moon {
		display: none;
	}

	.block-row {
		display: flex;
		gap: 0.35rem;
		margin-top: 1.8rem;
	}
	.block-row span {
		position: relative;
		width: 2.1rem;
		height: 0.9rem;
		background: var(--card);
		border-radius: 3px;
	}
	/* The notch on top of each block. */
	.block-row span::before {
		content: '';
		position: absolute;
		top: -3px;
		left: 0.45rem;
		width: 0.7rem;
		height: 4px;
		background: var(--card);
		border-radius: 2px 2px 0 0;
	}
	h1 {
		margin: 0.9rem 0 0.5rem;
		font-size: clamp(1.5rem, 3.2vw, 2rem);
	}
	.lede {
		color: var(--text-muted);
		max-width: 62ch;
		margin: 0 0 1.5rem;
		/* Spreads the lines evenly instead of leaving one word on the last. */
		text-wrap: balance;
	}
	.notice {
		text-wrap: balance;
		border: 1px dashed var(--border);
		border-radius: var(--radius-sm);
		padding: 0.7rem 0.9rem;
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 1.5rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
		gap: 1.1rem;
		padding-bottom: 3rem;
	}

	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		border-top: 1px solid var(--border);
		padding-block: 1.3rem;
		color: var(--text-muted);
		font-size: 0.88rem;
	}
	.copyright a {
		color: inherit;
		text-decoration: none;
	}
	.copyright a:hover {
		color: var(--accent);
	}
	.site-footer .legal {
		display: flex;
		gap: 1rem;
	}
	.site-footer .legal a {
		color: var(--text-muted);
		text-decoration: none;
	}
	.site-footer .legal a:hover {
		color: var(--accent);
	}
</style>
