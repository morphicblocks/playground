---
import { appLinks } from '../config';
import { blockColor } from '../palette';
import type { PlaygroundApp } from '../apps';
import {
	BUNDLERS,
	FRAMEWORKS,
	LANGUAGES,
	PACKAGE_MANAGERS,
	STYLING,
	VIEWS,
} from '../../../scripts/manifest';

interface Props {
	apps: PlaygroundApp[];
}

const { apps } = Astro.props;
---

<section class="compare" aria-labelledby="compare-heading">
	<h2 id="compare-heading">Compare the apps</h2>
	<div class="scroll">
		<table>
			<thead>
				<tr>
					<th scope="col">App</th>
					<th scope="col">Use case</th>
					<th scope="col">Framework</th>
					<th scope="col">Bundler</th>
					<th scope="col">Packages</th>
					<th scope="col">Styling</th>
					<th scope="col">Views</th>
					<th scope="col">Code shown</th>
				</tr>
			</thead>
			<tbody>
				{
					apps.map((app, index) => (
						<tr style={`--card: ${blockColor(index)}`}>
							<th scope="row">
								<a href={appLinks(app.id).open} target="_blank" rel="noopener">
									<span class="dot" aria-hidden="true" />
									{app.name}
								</a>
							</th>
							<td class="use-case">
								{app.useCase}
								<button
									class="question"
									type="button"
									aria-label={`The question this app answers: ${app.question}`}
									data-question={app.question}>
									i
								</button>
							</td>
							<td>
								{app.framework === 'none' && app.language
									? `None (${LANGUAGES[app.language].label})`
									: FRAMEWORKS[app.framework].label}
							</td>
							<td>{BUNDLERS[app.bundler].label}</td>
							<td>{PACKAGE_MANAGERS[app.packageManager].label}</td>
							<td>{STYLING[app.styling].label}</td>
							<td>{app.views.map((view) => VIEWS[view].label).join(', ')}</td>
							<td>{app.codeShown.join(', ')}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</section>

<!-- One floating box for all questions. It lives outside the table, so the
     table's sideways scrolling cannot cut it off. -->
<div id="question-tip" role="tooltip" hidden></div>

<script is:inline>
	(() => {
		const tip = document.getElementById('question-tip');
		if (!tip) return;
		let current = null;
		let shownAt = 0;
		const place = () => {
			if (!current) return;
			const box = current.getBoundingClientRect();
			const left = Math.min(box.left, innerWidth - tip.offsetWidth - 8);
			tip.style.left = `${Math.max(8, left)}px`;
			tip.style.top = `${box.bottom + 6}px`;
		};
		const show = (button) => {
			if (current !== button) shownAt = Date.now();
			current = button;
			tip.textContent = button.dataset.question;
			tip.hidden = false;
			place();
		};
		const hide = () => {
			current = null;
			tip.hidden = true;
		};
		document.querySelectorAll('button.question').forEach((button) => {
			button.addEventListener('mouseenter', () => show(button));
			button.addEventListener('mouseleave', hide);
			button.addEventListener('focus', () => show(button));
			button.addEventListener('blur', hide);
			// Phones have no hover: a tap opens the box, a later tap closes it. A
			// tap also focuses the button, so ignore the click that comes with it.
			button.addEventListener('click', () => {
				if (current === button && Date.now() - shownAt > 300) hide();
				else show(button);
			});
		});
		addEventListener('keydown', (event) => event.key === 'Escape' && hide());
		// The box is fixed on screen, so it follows its icon when the page or
		// the table scrolls.
		addEventListener('scroll', place, true);
		addEventListener('resize', place);
	})();
</script>

<style>
	#question-tip {
		position: fixed;
		z-index: 10;
		max-width: 20rem;
		padding: 0.75rem 1rem;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.4;
		color: var(--badge-text);
		background: var(--badge-bg);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		box-shadow: 0 6px 18px rgb(0 0 0 / 0.18);
	}
	#question-tip[hidden] {
		display: none;
	}
	.compare {
		padding-bottom: 3rem;
	}
	h2 {
		font-size: 1.2rem;
		margin: 0 0 0.9rem;
	}
	/* Wide tables scroll sideways on small screens instead of squeezing. */
	.scroll {
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.88rem;
		background: var(--surface);
	}
	th,
	td {
		padding: 0.6rem 0.8rem;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--border);
	}
	/* Headings and names stay on one line; longer values may wrap. */
	th {
		white-space: nowrap;
	}
	td {
		min-width: 5.5rem;
	}
	tbody tr:last-child > * {
		border-bottom: 0;
	}
	thead th {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--text-muted);
		background: var(--preview-bg);
	}
	/* The app name stays in view while the rest scrolls. */
	th:first-child {
		position: sticky;
		left: 0;
		background: var(--surface);
	}
	thead th:first-child {
		background: var(--preview-bg);
	}
	tbody th a {
		color: var(--text);
		text-decoration: none;
	}
	tbody th a:hover {
		color: var(--card);
	}
	/* The app's block color, as on its card. */
	.dot {
		display: inline-block;
		width: 0.7rem;
		height: 0.7rem;
		margin-right: 0.5rem;
		vertical-align: -0.05rem;
		background: var(--card);
		border-radius: 3px;
	}
	td {
		color: var(--text-muted);
	}
	/* The use case and its ⓘ stay on one line. */
	.use-case {
		white-space: nowrap;
	}
	.question {
		display: inline-grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		margin-left: 0.35rem;
		padding: 0;
		vertical-align: -0.15rem;
		font: italic 700 0.8rem/1 Georgia, serif;
		color: var(--badge-text);
		background: var(--badge-bg);
		border: 0;
		border-radius: 999px;
		cursor: help;
	}
	.question:hover,
	.question:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}
</style>
