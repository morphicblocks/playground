---
import { Icon } from 'astro-icon/components';
import { appLinks, externalAttrs } from '../config';
import type { PlaygroundApp } from '../apps';
import { BUNDLERS, FRAMEWORKS, PACKAGE_MANAGERS } from '../../../scripts/manifest';

interface Props {
	app: PlaygroundApp;
}

const { app } = Astro.props;
const links = appLinks(app.id);

// Framework, bundler and package manager as logos, each tool once (Bun can
// be both bundler and package manager). "No framework" has no logo to show.
const stack = [
	app.framework === 'none' ? undefined : FRAMEWORKS[app.framework],
	BUNDLERS[app.bundler],
	PACKAGE_MANAGERS[app.packageManager],
].filter((term, index, all): term is { label: string; icon?: string } =>
	!!term && all.findIndex((other) => other?.label === term.label) === index,
);
---

<article class="card">
	<div class="preview">
		{
			app.preview ? (
				<img src={app.preview} alt={`${app.name} preview`} loading="lazy" />
			) : (
				<span class="preview-fallback">{app.name}</span>
			)
		}
	</div>

	<div class="body">
		<h2>{app.name}</h2>
		<p class="desc">{app.description}</p>

		<ul class="stack" aria-label="Tech stack">
			{
				stack.map((entry) => {
					return (
						<li title={entry.label}>
							{entry.icon ? (
								<>
									<Icon name={entry.icon} />
									<span class="sr-only">{entry.label}</span>
								</>
							) : (
								<span class="pill">{entry.label}</span>
							)}
						</li>
					);
				})
			}
		</ul>

		<div class="actions">
			<a class="btn btn-primary" href={links.open}>
				Open app
			</a>
			{links.source && (
				<a
					class="btn btn-ghost"
					href={links.source}
					{...externalAttrs(links.source)}>
					Source
				</a>
			)}
			{links.degit && (
				<button class="btn btn-ghost copy" data-copy={links.degit} type="button">
					Copy CLI
				</button>
			)}
		</div>
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		transition: border-color 0.15s ease;
	}
	.card:hover {
		border-color: var(--accent);
	}

	.preview {
		position: relative;
		aspect-ratio: 16 / 9;
		display: grid;
		place-items: center;
		background: var(--preview-bg);
		border-bottom: 1px solid var(--border);
	}
	.preview img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.preview-fallback {
		font-weight: 600;
		color: var(--text-muted);
		padding: 0 1rem;
		text-align: center;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1rem 1.1rem 1.15rem;
		flex: 1;
	}
	h2 {
		font-size: 1.05rem;
		margin: 0;
	}
	.desc {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.92rem;
		flex: 1;
	}

	.stack {
		display: flex;
		gap: 0.55rem;
		list-style: none;
		margin: 0;
		padding: 0;
		color: var(--text-muted);
	}
	.stack li {
		display: grid;
		place-items: center;
	}
	.stack [data-icon] {
		width: 1.15rem;
		height: 1.15rem;
	}
	.pill {
		font-size: 0.7rem;
		font-weight: 600;
		line-height: 1;
		padding: 0.25rem 0.4rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
	}

	.actions {
		display: flex;
		gap: 0.45rem;
		flex-wrap: wrap;
		margin-top: 0.25rem;
	}
	.btn {
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.4rem 0.75rem;
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		cursor: pointer;
		text-decoration: none;
	}
	.btn-primary {
		background: var(--accent);
		color: #fff;
	}
	.btn-ghost {
		background: transparent;
		border-color: var(--border);
		color: var(--text);
	}
	.btn-ghost:hover {
		border-color: var(--accent);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
