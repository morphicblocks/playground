---
import { Icon } from 'astro-icon/components';
import { appLinks, externalAttrs } from '../config';
import type { PlaygroundApp } from '../apps';
import { BUNDLERS, FRAMEWORKS, PACKAGE_MANAGERS } from '../../../scripts/manifest';

interface Props {
	app: PlaygroundApp;
}

const { app } = Astro.props;
const links = appLinks(app.id);
// Blank lines in `details` separate paragraphs.
const paragraphs = app.details.split(/\n\s*\n/).map((text) => text.trim()).filter(Boolean);

// Framework, bundler and package manager as logos, each tool once (Bun can
// be both bundler and package manager). "No framework" has no logo to show.
const stack = [
	app.framework === 'none' ? undefined : FRAMEWORKS[app.framework],
	BUNDLERS[app.bundler],
	PACKAGE_MANAGERS[app.packageManager],
].filter((term, index, all): term is { label: string; icon?: string } =>
	!!term && all.findIndex((other) => other?.label === term.label) === index,
);
---

<article class="card">
	<div class="preview">
		{
			app.preview ? (
				<img src={app.preview} alt={`${app.name} preview`} loading="lazy" />
			) : (
				<span class="preview-fallback">{app.name}</span>
			)
		}
	</div>

	<div class="body">
		<h2>
			<!-- The whole card opens the app: this link's click area stretches
			     over the card, while the buttons below sit on top of it. -->
			<a class="card-link" href={links.open} target="_blank" rel="noopener">
				{app.name}
			</a>
		</h2>
		<p class="desc">{app.description}</p>

		<details class="more">
			<summary>More</summary>
			{paragraphs.map((text) => <p>{text}</p>)}
		</details>

		<ul class="stack" aria-label="Tech stack">
			{
				stack.map((entry) => {
					return (
						<li title={entry.label}>
							{entry.icon ? (
								<>
									<Icon name={entry.icon} />
									<span class="sr-only">{entry.label}</span>
								</>
							) : (
								<span class="pill">{entry.label}</span>
							)}
						</li>
					);
				})
			}
		</ul>

		<div class="actions">
			{
				links.download ? (
					<a class="btn btn-primary" href={links.download} download>
						Download
					</a>
				) : (
					<button class="btn btn-primary" type="button" disabled>
						Download
					</button>
				)
			}
			{links.source && (
				<a
					class="btn btn-ghost"
					href={links.source}
					{...externalAttrs(links.source)}>
					Source
				</a>
			)}
			{links.cli && (
				<button class="btn btn-ghost copy" data-copy={links.cli} type="button">
					Copy CLI
				</button>
			)}
		</div>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		transition: border-color 0.15s ease;
	}
	.card:hover,
	.card:has(.card-link:focus-visible) {
		border-color: var(--accent);
	}
	.card-link {
		color: inherit;
		text-decoration: none;
	}
	.card-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.card-link:focus-visible {
		outline: none;
	}
	.card:has(.card-link:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.preview {
		position: relative;
		aspect-ratio: 16 / 9;
		display: grid;
		place-items: center;
		background: var(--preview-bg);
		border-bottom: 1px solid var(--border);
	}
	.preview img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.preview-fallback {
		font-weight: 600;
		color: var(--text-muted);
		padding: 0 1rem;
		text-align: center;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1rem 1.1rem 1.15rem;
		flex: 1;
	}
	h2 {
		font-size: 1.05rem;
		margin: 0;
	}
	.desc {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.92rem;
	}

	/* Logos and buttons sit at the bottom, level across a row of cards. */
	.stack {
		display: flex;
		gap: 0.55rem;
		list-style: none;
		margin: auto 0 0;
		padding: 0;
		color: var(--text-muted);
	}
	.stack li {
		display: grid;
		place-items: center;
	}
	.stack [data-icon] {
		width: 1.15rem;
		height: 1.15rem;
	}
	.pill {
		font-size: 0.7rem;
		font-weight: 600;
		line-height: 1;
		padding: 0.25rem 0.4rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
	}

	/* Above the card link, so opening it does not open the app. */
	.more {
		position: relative;
		z-index: 1;
		font-size: 0.88rem;
		color: var(--text-muted);
	}
	.more summary {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		cursor: pointer;
		font-weight: 600;
		color: var(--text);
		list-style: none;
	}
	.more summary::-webkit-details-marker {
		display: none;
	}
	.more summary::after {
		content: '';
		width: 0.4rem;
		height: 0.4rem;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: translateY(-0.1rem) rotate(45deg);
		transition: transform 0.15s ease;
	}
	.more[open] summary::after {
		transform: translateY(0.1rem) rotate(-135deg);
	}
	.more summary:hover {
		color: var(--accent);
	}
	.more p {
		margin: 0.5rem 0 0;
	}

	/* Above the card link, so each button keeps its own action. */
	.actions {
		position: relative;
		z-index: 1;
		display: flex;
		gap: 0.45rem;
		flex-wrap: wrap;
		margin-top: 0.25rem;
	}
	.btn {
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.4rem 0.75rem;
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		cursor: pointer;
		text-decoration: none;
	}
	.btn-primary {
		background: var(--accent);
		color: #fff;
	}
	.btn:disabled {
		background: var(--border);
		color: var(--text-muted);
		cursor: default;
	}
	.btn-ghost {
		background: transparent;
		border-color: var(--border);
		color: var(--text);
	}
	.btn-ghost:hover {
		border-color: var(--accent);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
