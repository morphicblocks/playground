---
import { Icon } from 'astro-icon/components';
import { appLinks, externalAttrs } from '../config';
import type { PlaygroundApp } from '../apps';
import { blockColor, displayIcon, iconColor } from '../palette';
import { logoOf } from '../logos';
import { BUNDLERS, PACKAGE_MANAGERS, STYLING, frameworkOrLanguage } from '../../../scripts/manifest';

interface Props {
	app: PlaygroundApp;
	/** Position in apps.json; picks the card's block color. */
	index: number;
}

const { app, index } = Astro.props;
const links = appLinks(app.id);
const logo = logoOf(app.id);
// Blank lines in `details` separate paragraphs.
const paragraphs = app.details.split(/\n\s*\n/).map((text) => text.trim()).filter(Boolean);

// Framework (or, without one, the language), bundler, package manager and
// styling as logos, each tool once (Bun can be both bundler and package
// manager).
const stack = [
	frameworkOrLanguage(app),
	BUNDLERS[app.bundler],
	PACKAGE_MANAGERS[app.packageManager],
	STYLING[app.styling],
].filter((term, index, all): term is { label: string; icon?: string } =>
	!!term && all.findIndex((other) => other?.label === term.label) === index,
);
---

<article class="card" style={`--card: ${blockColor(index)}`}>
	<div class="preview">
		{
			app.preview ? (
				<img src={app.preview} alt={`${app.name} preview`} loading="lazy" />
			) : (
				<span class="preview-fallback" aria-hidden="true">{app.name}</span>
			)
		}
	</div>

	<div class="body">
		<h2>
			<!-- The whole card opens the app: this link's click area stretches
			     over the card, while the buttons below sit on top of it. -->
			<a class="card-link" href={links.open} target="_blank" rel="noopener">
				{app.name}
				{logo && <img class="logo" src={logo} alt="" width="28" height="28" />}
			</a>
		</h2>
		<p class="desc">{app.description}</p>

		<details class="more">
			<summary>More</summary>
			{paragraphs.map((text) => <p>{text}</p>)}
		</details>

		<ul class="stack" aria-label="Tech stack">
			{
				stack.map((entry) => {
					return (
						<li title={entry.label} style={iconColor(entry.icon) && `color: ${iconColor(entry.icon)}`}>
							{entry.icon ? (
								<>
									<Icon name={displayIcon(entry.icon)} />
									<span class="sr-only">{entry.label}</span>
								</>
							) : (
								<span class="short" aria-label={entry.label}>{entry.label.slice(0, 2)}</span>
							)}
						</li>
					);
				})
			}
		</ul>

		<div class="actions">
			{
				links.download ? (
					<a class="btn btn-primary" href={links.download} download>
						Download
					</a>
				) : (
					<button class="btn btn-primary" type="button" disabled>
						Download
					</button>
				)
			}
			{links.source && (
				<a
					class="btn btn-ghost"
					href={links.source}
					{...externalAttrs(links.source)}>
					Source
				</a>
			)}
			{links.cli && (
				<button class="btn btn-ghost copy" data-copy={links.cli} type="button">
					Copy CLI
				</button>
			)}
		</div>
	</div>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		transition: border-color 0.15s ease;
	}
	.card:hover,
	.card:has(.card-link:focus-visible) {
		border-color: var(--card);
	}
	.card-link {
		color: inherit;
		text-decoration: none;
	}
	.card-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.card-link:focus-visible {
		outline: none;
	}
	.card:has(.card-link:focus-visible) {
		outline: 2px solid var(--card);
		outline-offset: 2px;
	}

	.preview {
		position: relative;
		aspect-ratio: 16 / 9;
		display: grid;
		place-items: center;
		/* The card's block color, faint, behind the preview. */
		background: color-mix(in srgb, var(--card) 14%, var(--preview-bg));
		border-bottom: 3px solid var(--card);
	}
	.preview img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	/* Until there is a preview image, the name sits on a block: a colored
	   plate with the notch a statement block has on top. */
	.preview-fallback {
		position: relative;
		max-width: calc(100% - 3rem);
		padding: 0.7rem 1.2rem;
		font-size: 1.15rem;
		font-weight: 700;
		color: #fff;
		text-align: center;
		background: var(--card);
		border-radius: 8px;
		box-shadow: 0 3px 0 color-mix(in srgb, var(--card) 70%, #000);
		transition: transform 0.15s ease;
	}
	.preview-fallback::before {
		content: '';
		position: absolute;
		top: -6px;
		left: 1.1rem;
		width: 1.6rem;
		height: 8px;
		background: var(--card);
		border-radius: 3px 3px 0 0;
	}
	.card:hover .preview-fallback {
		transform: translateY(-3px);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1rem 1.1rem 1.15rem;
		flex: 1;
	}
	h2 {
		font-size: 1.05rem;
		margin: 0;
	}
	/* The app's name on the left, its logo at the right end of the line. */
	.card-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
	}
	.logo {
		flex: none;
		border-radius: 7px;
	}
	.desc {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.92rem;
	}

	/* Logos and buttons sit at the bottom, level across a row of cards. */
	.stack {
		display: flex;
		gap: 0.7rem;
		list-style: none;
		margin: auto 0 0;
		padding: 0;
		color: var(--text-muted);
	}
	.stack li {
		display: grid;
		place-items: center;
	}
	.stack [data-icon] {
		width: 1.3rem;
		height: 1.3rem;
	}
	/* A tool without a logo: its first letters in a framed square the size of
	   a logo, the full name in the tooltip. */
	.short {
		display: grid;
		place-items: center;
		width: 1.3rem;
		height: 1.3rem;
		font-size: 0.6rem;
		font-weight: 800;
		line-height: 1;
		border: 2px solid currentColor;
		border-radius: 4px;
	}

	/* Above the card link, so opening it does not open the app. */
	.more {
		position: relative;
		z-index: 1;
		font-size: 0.88rem;
		color: var(--text-muted);
	}
	.more summary {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		cursor: pointer;
		font-weight: 600;
		color: var(--text);
		list-style: none;
	}
	.more summary::-webkit-details-marker {
		display: none;
	}
	.more summary::after {
		content: '';
		width: 0.4rem;
		height: 0.4rem;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: translateY(-0.1rem) rotate(45deg);
		transition: transform 0.15s ease;
	}
	.more[open] summary::after {
		transform: translateY(0.1rem) rotate(-135deg);
	}
	.more summary:hover {
		color: var(--card);
	}
	.more p {
		margin: 0.5rem 0 0;
	}

	/* Above the card link, so each button keeps its own action. */
	.actions {
		position: relative;
		z-index: 1;
		display: flex;
		gap: 0.45rem;
		flex-wrap: wrap;
		margin-top: 0.25rem;
	}
	.btn {
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.4rem 0.75rem;
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		cursor: pointer;
		text-decoration: none;
	}
	/* The same on every card: the inverse of the outlined buttons beside it. */
	.btn-primary {
		background: var(--text);
		color: var(--surface);
	}
	.btn-primary:not(:disabled):hover {
		background: color-mix(in srgb, var(--text) 80%, var(--surface));
	}
	.btn:disabled {
		background: var(--border);
		color: var(--text-muted);
		cursor: default;
	}
	.btn-ghost {
		background: transparent;
		border-color: var(--border);
		color: var(--text);
	}
	.btn-ghost:hover {
		border-color: var(--card);
		color: var(--card);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
