      "identifier": "say",
      "category": "Output",
      "elements": {
        "symbols": "<img src='icons/say.svg' width='24' height='24' alt='say'> say %1",
        "words": "say %1",
        "java": "System.out.println(%1);",
        "help": "Shows a text or a number below the program."
