        "1": {
          "kind": "value",
          "name": "VALUE",
          "default": {
            "shadow": "number",
            "fieldValues": {
              "NUM": "1"
            }
          }
        }
      },
      "fields": {
        "NAME": {
          "type": "text",
          "default": "score"
        }
      },
      "shape": "statement",
      "inputsInline": true
    },
    {
      "identifier": "get",
      "category": "Variables",
      "elements": {
        "symbols": "<img src='icons/box.svg' width='20' height='20' alt='box'> %NAME",
        "words": "%NAME",
        "java": "%NAME",
        "help": "Gives the value that is in a box right now."
      },
      "fields": {
        "NAME": {
          "type": "text",
          "default": "score"
        }
      },
      "output": true
    },
    {
      "identifier": "compare",
      "category": "Control",
      "elements": {
        "symbols": "%1 %OP %2",
        "words": "%1 %OP %2",
        "java": "%1 %OP %2",
        "help": "Checks two numbers. The answer is yes or no."
      },
      "inputSlots": {
        "1": {
          "kind": "value",
          "name": "A",
          "default": {
            "shadow": "number",
            "fieldValues": {
              "NUM": "1"
            }
          }
        },
        "2": {
          "kind": "value",
          "name": "B",
          "default": {
            "shadow": "number",
            "fieldValues": {
              "NUM": "2"
            }
          }
        }
      },
      "fields": {
        "OP": {
          "type": "dropdown",
          "options": [
            {
              "value": "<",
              "display": {
                "words": "is less than"
              }
            },
            {
              "value": ">",
              "display": {
                "words": "is more than"
              }
            },
            {
              "value": "==",
              "display": {
                "words": "is the same as",
                "symbols": "="
              }
            }
          ],
          "default": "<"
        }
      },
      "output": "Boolean",
      "inputsInline": true
    },
    {
      "identifier": "if_else",
      "category": "Control",
      "elements": {
        "symbols": "<img src='icons/if.svg' width='24' height='24' alt='if'> if %1\n%2\n<img src='icons/else.svg' width='24' height='24' alt='else'> else\n%3",
        "words": "if %1 then\n    %2\notherwise\n    %3",
        "java": "if (%1) {\n    %2\n} else {\n    %3\n}",
        "help": "Runs the first blocks when the answer is yes, and the second ones when it is no."
      },
      "inputSlots": {
        "1": {
          "kind": "value",
          "name": "CONDITION",
          "check": "Boolean"
        },
        "2": {
          "kind": "statement",
          "name": "THEN"
        },
        "3": {
          "kind": "statement",
          "name": "ELSE"
        }
      },
      "shape": "statement",
      "inputsInline": true
    },
    {
      "identifier": "repeat",
      "category": "Control",
      "elements": {
        "symbols": "<img src='icons/repeat.svg' width='24' height='24' alt='repeat'> %1 times\n%2",
        "words": "repeat %1 times\n    %2",
        "java": "for (int i = 0; i < %1; i++) {\n    %2\n}",
        "help": "Runs the blocks inside again and again, as many times as the number says."
      },
      "inputSlots": {
        "1": {
          "kind": "value",
          "name": "TIMES",
          "default": {
            "shadow": "number",
            "fieldValues": {
              "NUM": "3"
            }
          }
        },
        "2": {
          "kind": "statement",
          "name": "DO"
        }
      },
      "shape": "statement",
      "inputsInline": true
    }
