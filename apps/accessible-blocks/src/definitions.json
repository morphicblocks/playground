        "words": "make %NAME be %1",
        "java": "var %NAME = %1;",
        "help": "Makes a new box with a name and puts a value in it. Use it once per name."
      },
      "inputSlots": {
        "1": {
          "kind": "value",
          "name": "VALUE",
          "default": {
            "shadow": "number",
            "fieldValues": {
              "NUM": "0"
            }
          }
        }
      },
      "fields": {
        "NAME": {
          "type": "text",
          "default": "score"
        }
      },
      "shape": "statement",
      "inputsInline": true
    },
    {
      "identifier": "add",
