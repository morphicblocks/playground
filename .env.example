# Copy to `.env` and fill in your own values. Build-time PUBLIC_* vars.
# On Cloudflare Pages, set these as environment variables.
# These are placeholders; real values go in `.env` (git-ignored).

PUBLIC_SITE_NAME="Example Playground"
PUBLIC_SITE_URL="https://playground.example.com"

# Used to derive each app's links:
#   source   → {PUBLIC_GITHUB_URL}/tree/main/apps/{id}
#   download → {PUBLIC_GITHUB_URL}/releases/latest/download/{id}.zip
#   CLI      → npx tiged {PUBLIC_REPO_SLUG}/apps/{id} {id}
PUBLIC_REPO_SLUG="your-org/your-repo"
PUBLIC_GITHUB_URL="https://github.com/your-org/your-repo"

PUBLIC_DOCS_URL="https://docs.example.com"
PUBLIC_LANDING_URL="https://example.com"

# Copyright holder shown in the footer
PUBLIC_UNIVERSITY="Your Organization"
PUBLIC_UNIVERSITY_URL="https://example.org/"

# Legal pages, required on every university web presence.
PUBLIC_IMPRINT_URL="/imprint"
PUBLIC_PRIVACY_URL="/privacy"
PUBLIC_DISCLAIMER_URL="/disclaimer"

# ── Deployment (Docker + Traefik) ──────────────────────────────────────
# Read by docker compose, not by the dev server. Everything else about the
# deployment is identical for every clone and is written directly in
# docker-compose.yaml / docker-compose.prod.yaml.

# Hostname Traefik should route to this container.
DEPLOY_DOMAIN="playground.example.com"

# Only when the build host reaches the internet through a proxy.
HTTP_PROXY=""
HTTPS_PROXY=""
NO_PROXY=""
